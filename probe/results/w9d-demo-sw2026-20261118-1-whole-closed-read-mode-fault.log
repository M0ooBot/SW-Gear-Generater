        build   Part12 · spur · recipe B · trig degrees
        ok      new part Part12
        ok      trig units measured: degrees
        ok      global "No. of Teeth"
        ok      global "Module"
        ok      global "Bore Diameter"
        ok      global "Pressure Angle"
        ok      global "Outer Diameter"
        ok      global "Pitch Diameter"
        ok      global "Backlash"
        ok      global "Arc Length"
        ok      global "Fillet Radius"
        ok      global "Tooth Depth"
        ok      global "Face Width"
        ok      global "Root Diameter"
        ok      global "Base Diameter"
        ok      global "Base Radius"
        ok      global "Tooth Thickness"
        ok      global "Half Space Angle"
        ok      global "Involute Fn"
        ok      global "Flank Offset"
        ok      global "Tip Cap Diameter"
        ok      global "Flank Start Diameter"
        ok      global "Involute t1"
        ok      global "Involute t2"
        ok      global "Flank Arc Radius"
        ok      global "Flank Centre Angle"
        ok      axis Gear Axis
        ok      sketch blank opened on plane 1
        ok      circle od
        ok      coincident od.centre origin
        ok      dimension OD
        ok      sketch Blank Sketch
        ok      extrude Blank
        ok      link "OD@Blank Sketch"
        ok      link "Width@Blank"
        ok      sketch space opened on plane 1
        ok      circle pitch
        ok      circle base
        ok      circle cap
        ok      line CL
        ok      line A
        ok      arc E+
        ok      arc E-
        ok      arc F+
        ok      arc F-
        ok      arc R
        ok      line T
        ok      coincident pitch.centre origin
        ok      coincident base.centre origin
        ok      coincident cap.centre origin
        ok      coincident R.centre origin
        ok      coincident CL.start origin
        ok      horizontal CL
        ok      coincident CL.end cap
        ok      coincident A.start origin
        ok      coincident A.end pitch
        ok      coincident E+.centre base
        ok      coincident A.end E+
        ok      coincident E+.end cap
        ok      symmetric E+.centre E-.centre CL
        ok      equal E+ E-
        ok      coincident E-.start cap
        ok      coincident F+.start E+.start (already one point)
        ok      coincident F+.end R.end (already one point)
        ok      tangent F+ E+
        ok      tangent F+ R
        ok      coincident F-.end E-.end (already one point)
        ok      coincident F-.start R.start (already one point)
        ok      tangent F- E-
        ok      tangent F- R
        ok      equal F+ F-
        ok      coincident T.start E+.end (already one point)
        ok      coincident T.end E-.start (already one point)
        ok      dimension Pitch
        ok      dimension Base
        ok      dimension Cap
        ok      dimension HalfSpace
        ok      dimension Flank
        ok      dimension Fillet
        ok      dimension Root
        ok      sketch Tooth Space Sketch
        ok      link "Pitch@Tooth Space Sketch"
        ok      link "Base@Tooth Space Sketch"
        ok      link "Cap@Tooth Space Sketch"
        ok      link "HalfSpace@Tooth Space Sketch"
        ok      link "Flank@Tooth Space Sketch"
        ok      link "Fillet@Tooth Space Sketch"
        ok      link "Root@Tooth Space Sketch"
        ok      cut Tooth Space
